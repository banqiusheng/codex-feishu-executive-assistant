#!/bin/zsh

emulate -LR zsh
set -euo pipefail

typeset node_executable="${commands[node]:-}"
if [[ -z "${node_executable}" ]]; then
  print -u2 -r -- "FAIL：未找到 Node.js。"
  exit 1
fi
node_executable="${node_executable:A}"

exec "${node_executable}" --input-type=module - "$@" <<'NODE'
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";

const LABEL = "com.codex-feishu.executive-assistant";
const KEYCHAIN_SERVICE = "com.codex-feishu-executive-assistant.bot";
const PRESENTATIONS_PLUGIN_ID = "presentations@openai-primary-runtime";
const EXPECTED_PPT = Object.freeze({
  schemaVersion: 1,
  repository: "https://github.com/banqiusheng/visual-first-ppt.git",
  tag: "v0.3.0",
  tagObjectSha: "4962eb9bd5c55e8384b5228993c241b2220fcabb",
  commitSha: "bb775f68f951c3e444d00623bc88976b20c13e7d",
  treeSha: "5ad18d178e8191105dcc68717e4639d3a68f0c73",
});
const EXPECTED_LARK_CLI = Object.freeze({
  package: "@larksuite/cli",
  version: "1.0.72",
  darwinArm64ArchiveSha256: "b27942b83e8821934ebd34fbb02e0b00bbca949255866b5010795d625442eae2",
  darwinAmd64ArchiveSha256: "b5dd56d64f9cc1cb7bab80b8eb1dda3c34e76f2a751115a897d0261985b82745",
});

function usage() {
  process.stdout.write(
    [
      "用法：./scripts/doctor [--json] [--config /绝对路径/assistant.json]",
      "",
      "doctor 只读取状态，不修复、不写 Keychain、不启动或重启服务。",
      "",
    ].join("\n"),
  );
}

let json = false;
let configPath = path.join(os.homedir(), "PresidentAssistant", "runtime", "config", "assistant.json");
const args = process.argv.slice(2);
for (let index = 0; index < args.length; index += 1) {
  const arg = args[index];
  if (arg === "--json") {
    json = true;
  } else if (arg === "--config") {
    const value = args[index + 1];
    if (!value) {
      process.stderr.write("--config 缺少值。\n");
      process.exit(64);
    }
    configPath = value;
    index += 1;
  } else if (arg === "--help" || arg === "-h") {
    usage();
    process.exit(0);
  } else {
    process.stderr.write(`未知参数：${arg}\n`);
    process.exit(64);
  }
}

const checks = [];
function add(id, status, detail) {
  checks.push(Object.freeze({ id, status, detail }));
}

function run(executable, argv, options = {}) {
  return spawnSync(executable, argv, {
    encoding: "utf8",
    timeout: options.timeout ?? 15_000,
    env: options.env ?? process.env,
    stdio: ["ignore", "pipe", "pipe"],
  });
}

function isPlainFile(candidate) {
  try {
    const stat = fs.lstatSync(candidate);
    return stat.isFile() && !stat.isSymbolicLink();
  } catch {
    return false;
  }
}

function safeMode(candidate) {
  return fs.lstatSync(candidate).mode & 0o777;
}

function hasSecretField(value) {
  if (!value || typeof value !== "object") return false;
  if (Array.isArray(value)) return value.some(hasSecretField);
  for (const [key, item] of Object.entries(value)) {
    if (["appSecret", "app_secret", "secretValue", "accessToken", "refreshToken", "token"].includes(key)) {
      return true;
    }
    if (hasSecretField(item)) return true;
  }
  return false;
}

let config = null;
if (!path.isAbsolute(configPath)) {
  add("config", "FAIL", "配置路径必须是绝对路径。");
} else if (!isPlainFile(configPath)) {
  add("config", "FAIL", "运行配置缺失、是符号链接或不是普通文件。");
} else {
  try {
    const stat = fs.lstatSync(configPath);
    if (stat.uid !== process.getuid() || safeMode(configPath) !== 0o600) {
      add("config", "FAIL", "运行配置必须由当前用户持有且权限为 0600。");
    } else {
      config = JSON.parse(fs.readFileSync(configPath, "utf8"));
      if (
        config?.schemaVersion !== 1 ||
        typeof config?.appId !== "string" ||
        !/^cli_[A-Za-z0-9_-]{6,128}$/.test(config.appId) ||
        (config?.tenantKey != null &&
          (typeof config.tenantKey !== "string" ||
            !/^[A-Za-z0-9_-]{2,128}$/.test(config.tenantKey))) ||
        !(
          (config?.presidentOpenId === null && config?.presidentChatId === null) ||
          (typeof config?.presidentOpenId === "string" &&
            config.presidentOpenId.length > 0 &&
            typeof config?.presidentChatId === "string" &&
            config.presidentChatId.length > 0)
        ) ||
        config?.secretRef?.type !== "macos-keychain" ||
        config?.secretRef?.service !== KEYCHAIN_SERVICE ||
        config?.secretRef?.account !== config.appId ||
        typeof config?.paths?.runtimeRoot !== "string" ||
        !path.isAbsolute(config.paths.runtimeRoot) ||
        typeof config?.paths?.larkHome !== "string" ||
        !path.isAbsolute(config.paths.larkHome) ||
        typeof config?.paths?.databasePath !== "string" ||
        path.dirname(config.paths.databasePath) !== config.paths.runtimeRoot ||
        config?.visualFirstPpt?.presentationsPlugin?.id !==
          PRESENTATIONS_PLUGIN_ID ||
        typeof config?.visualFirstPpt?.presentationsPlugin?.version !==
          "string" ||
        hasSecretField(config)
      ) {
        add("config", "FAIL", "运行配置 schema、Keychain 引用或无秘密边界不符合要求。");
        config = null;
      } else {
        add("config", "PASS", "运行配置合法、权限为 0600，且没有秘密字段。");
      }
    }
  } catch {
    add("config", "FAIL", "运行配置无法安全解析。");
    config = null;
  }
}

const configuredNode = config?.executables?.node;
if (typeof configuredNode !== "string" || !path.isAbsolute(configuredNode) || !isPlainFile(configuredNode)) {
  add("node", "FAIL", "配置中的 Node.js 绝对路径不可用。");
} else {
  const result = run(configuredNode, ["--version"]);
  const match = `${result.stdout ?? ""}${result.stderr ?? ""}`.match(/v?(\d+)\./);
  const major = match ? Number.parseInt(match[1], 10) : NaN;
  if (result.status !== 0 || !Number.isSafeInteger(major) || major < 20 || major % 2 !== 0) {
    add("node", "FAIL", "Node.js 必须是受支持的 20 或更高偶数主版本。");
  } else {
    add("node", "PASS", `Node.js ${major} 可用。`);
  }
}

const runtimeEntry = config?.executables?.runtimeEntry;
if (typeof runtimeEntry === "string" && path.isAbsolute(runtimeEntry) && isPlainFile(runtimeEntry)) {
  add("runtime-entry", "PASS", "runtime 构建入口存在。");
} else {
  add("runtime-entry", "FAIL", "packages/runtime/dist/cli.js 不存在或不是可信普通文件。");
}

const codexExecutable = config?.executables?.codex;
const codexHome = config?.paths?.codexHome;
let presentationsVerified = false;
if (
  typeof codexExecutable !== "string" ||
  !path.isAbsolute(codexExecutable) ||
  !isPlainFile(codexExecutable) ||
  typeof codexHome !== "string" ||
  !path.isAbsolute(codexHome)
) {
  add("codex-login", "FAIL", "Codex 可执行文件或专用 CODEX_HOME 配置无效。");
} else {
  const result = run(codexExecutable, ["login", "status"], {
    timeout: 20_000,
    env: { ...process.env, CODEX_HOME: codexHome },
  });
  add(
    "codex-login",
    result.status === 0 ? "PASS" : "FAIL",
    result.status === 0 ? "专用 CODEX_HOME 已登录。" : "专用 CODEX_HOME 尚未完成 Codex 登录。",
  );
}

if (
  typeof codexExecutable !== "string" ||
  typeof codexHome !== "string" ||
  !isPlainFile(codexExecutable)
) {
  add("presentations", "FAIL", "无法使用专用 Codex 环境核验 Presentations 插件。");
} else {
  const result = run(
    codexExecutable,
    [
      "plugin",
      "list",
      "--marketplace",
      "openai-primary-runtime",
      "--available",
      "--json",
    ],
    {
      timeout: 20_000,
      env: { ...process.env, CODEX_HOME: codexHome },
    },
  );
  try {
    if (result.status !== 0) throw new Error("plugin_list_failed");
    const report = JSON.parse(result.stdout);
    const entries = [...(report.installed ?? []), ...(report.available ?? [])];
    const plugin = entries.find((entry) => entry.pluginId === PRESENTATIONS_PLUGIN_ID);
    if (
      plugin?.installed !== true ||
      plugin?.enabled !== true ||
      plugin?.marketplaceName !== "openai-primary-runtime" ||
      plugin?.marketplaceSource?.sourceType !== "local" ||
      plugin?.version !== config?.visualFirstPpt?.presentationsPlugin?.version
    ) {
      throw new Error("presentations_identity");
    }
    presentationsVerified = true;
    add(
      "presentations",
      "PASS",
      `专用 CODEX_HOME 已启用官方 Presentations ${plugin.version}。`,
    );
  } catch {
    add(
      "presentations",
      "FAIL",
      "专用 CODEX_HOME 未启用配置所锁定的官方 Presentations 插件。",
    );
  }
}

const imagegenSkill = path.join(
  typeof codexHome === "string" ? codexHome : "",
  "skills",
  ".system",
  "imagegen",
  "SKILL.md",
);
add(
  "imagegen",
  "WARN",
  isPlainFile(imagegenSkill)
    ? "发现专用 Home 的 imagegen Skill，但只读 doctor 无法证明新 CLI 会话暴露 image_gen 系统工具；真实 PPT 仍需目标机验收。"
    : "专用 Home 中没有 imagegen 的权威本地证据；只读 doctor 无法证明系统工具已暴露，真实 PPT 保持 BLOCKED_CAPABILITY。",
);

if (config) {
  const result = run("/usr/bin/security", [
    "find-generic-password",
    "-a",
    config.appId,
    "-s",
    config.secretRef.service,
  ]);
  add(
    "keychain-item",
    result.status === 0 ? "PASS" : "FAIL",
    result.status === 0
      ? "Bot App Secret 的 Keychain item 存在；doctor 未读取其值。"
      : "Bot App Secret 的 Keychain item 不存在。",
  );
}

const larkCliExecutable = config?.executables?.larkCli;
const runtimeRoot = config?.paths?.runtimeRoot;
const larkHome = config?.paths?.larkHome;
let larkCliVerified = false;
if (
  typeof larkCliExecutable !== "string" ||
  !path.isAbsolute(larkCliExecutable) ||
  !isPlainFile(larkCliExecutable) ||
  typeof runtimeRoot !== "string" ||
  !path.isAbsolute(runtimeRoot) ||
  typeof larkHome !== "string" ||
  !path.isAbsolute(larkHome)
) {
  add("lark-cli", "FAIL", "私有 lark-cli 或独立 HOME 的绝对路径不可用。");
} else {
  try {
    const releaseRoot = path.join(
      runtimeRoot,
      `lark-cli-${EXPECTED_LARK_CLI.version}`,
    );
    const expectedExecutable = path.join(releaseRoot, "private-bin", "lark-cli");
    if (larkCliExecutable !== expectedExecutable) {
      throw new Error("lark_cli_release_layout");
    }
    const stat = fs.lstatSync(larkCliExecutable);
    if (stat.uid !== process.getuid() || safeMode(larkCliExecutable) !== 0o500) {
      throw new Error("lark_cli_permissions");
    }
    const receiptPath = path.join(releaseRoot, "install-receipt.json");
    if (!isPlainFile(receiptPath) || safeMode(receiptPath) !== 0o600) {
      throw new Error("lark_cli_receipt");
    }
    const receipt = JSON.parse(fs.readFileSync(receiptPath, "utf8"));
    const expectedArchiveSha =
      os.arch() === "arm64"
        ? EXPECTED_LARK_CLI.darwinArm64ArchiveSha256
        : os.arch() === "x64"
          ? EXPECTED_LARK_CLI.darwinAmd64ArchiveSha256
          : null;
    const expectedUrl = expectedArchiveSha
      ? `https://github.com/larksuite/cli/releases/download/v${EXPECTED_LARK_CLI.version}/lark-cli-${EXPECTED_LARK_CLI.version}-darwin-${os.arch() === "arm64" ? "arm64" : "amd64"}.tar.gz`
      : null;
    const binarySha256 = createHash("sha256")
      .update(fs.readFileSync(larkCliExecutable))
      .digest("hex");
    if (
      expectedArchiveSha === null ||
      receipt.schemaVersion !== 1 ||
      receipt.package !== EXPECTED_LARK_CLI.package ||
      receipt.version !== EXPECTED_LARK_CLI.version ||
      receipt.archiveSha256 !== expectedArchiveSha ||
      receipt.sourceUrl !== expectedUrl ||
      receipt.binarySha256 !== binarySha256
    ) {
      throw new Error("lark_cli_identity");
    }
    const versionResult = run(larkCliExecutable, ["--version"]);
    if (
      versionResult.status !== 0 ||
      !`${versionResult.stdout ?? ""}${versionResult.stderr ?? ""}`.includes(
        EXPECTED_LARK_CLI.version,
      )
    ) {
      throw new Error("lark_cli_version");
    }
    const homeStat = fs.lstatSync(larkHome);
    if (
      !homeStat.isDirectory() ||
      homeStat.isSymbolicLink() ||
      homeStat.uid !== process.getuid() ||
      safeMode(larkHome) !== 0o700 ||
      fs.realpathSync(larkHome) !== larkHome
    ) {
      throw new Error("lark_home_identity");
    }
    larkCliVerified = true;
    add("lark-cli", "PASS", "锁定的 lark-cli 1.0.72 位于私有目录，版本、SHA 和收据一致。");
  } catch {
    add("lark-cli", "FAIL", "私有 lark-cli 或独立 HOME 的路径、权限、版本、SHA 或来源收据不匹配。");
  }
}

if (!larkCliVerified || typeof larkHome !== "string") {
  add("user-oauth", "FAIL", "无法在可信飞书 CLI 环境中核验总裁用户授权。");
} else {
  const result = run(
    larkCliExecutable,
    ["--profile", "executive-assistant", "auth", "status", "--json"],
    {
      env: {
        PATH: "/usr/bin:/bin:/usr/sbin:/sbin",
        HOME: larkHome,
        LANG: "C",
        LC_ALL: "C",
      },
    },
  );
  let healthy = false;
  try {
    const report = JSON.parse(result.stdout);
    healthy = result.status === 0 && report?.ok === true;
  } catch {
    healthy = false;
  }
  add(
    "user-oauth",
    healthy ? "PASS" : "FAIL",
    healthy
      ? "总裁的日历、通讯录和妙记用户授权已配置；doctor 未输出任何令牌。"
      : "总裁用户授权不存在或已失效；请重新运行安装程序完成授权。",
  );
}

const databasePath = config?.paths?.databasePath;
if (typeof databasePath !== "string" || !path.isAbsolute(databasePath)) {
  add("sqlite", "FAIL", "SQLite 路径配置无效。");
} else if (!fs.existsSync(databasePath)) {
  add("sqlite", "WARN", "运行时尚未创建 SQLite 数据库。");
} else if (!isPlainFile(databasePath) || safeMode(databasePath) !== 0o600) {
  add("sqlite", "FAIL", "SQLite 必须是权限 0600 的普通文件。");
} else if (!isPlainFile("/usr/bin/sqlite3")) {
  add("sqlite", "WARN", "系统没有 /usr/bin/sqlite3，无法执行只读 quick_check。");
} else {
  const result = run("/usr/bin/sqlite3", ["-readonly", databasePath, "PRAGMA quick_check;"]);
  add(
    "sqlite",
    result.status === 0 && result.stdout.trim() === "ok" ? "PASS" : "FAIL",
    result.status === 0 && result.stdout.trim() === "ok"
      ? "SQLite quick_check 返回 ok。"
      : "SQLite quick_check 未通过。",
  );
}

const plistPath = path.join(os.homedir(), "Library", "LaunchAgents", `${LABEL}.plist`);
if (!isPlainFile(plistPath)) {
  add("launchd-plist", "FAIL", "LaunchAgent plist 不存在或不是可信普通文件。");
} else {
  const result = run("/usr/bin/plutil", ["-lint", plistPath]);
  add(
    "launchd-plist",
    result.status === 0 ? "PASS" : "FAIL",
    result.status === 0 ? "LaunchAgent plist 可解析。" : "LaunchAgent plist 无法解析。",
  );
}

const launchDomain = `gui/${process.getuid()}`;
const launchResult = run("/bin/launchctl", ["print", `${launchDomain}/${LABEL}`]);
add(
  "launchd-service",
  launchResult.status === 0 ? "PASS" : "FAIL",
  launchResult.status === 0 ? "LaunchAgent 已加载。" : "LaunchAgent 尚未加载。",
);

function exactPairingIdentifier(value) {
  return (
    typeof value === "string" &&
    value.length > 0 &&
    value.length <= 512 &&
    value === value.trim() &&
    !value.includes("\0")
  );
}

if (
  config &&
  exactPairingIdentifier(config.presidentOpenId) &&
  exactPairingIdentifier(config.presidentChatId) &&
  exactPairingIdentifier(config.tenantKey) &&
  config.pairing?.enabled === false
) {
  add("pairing", "PASS", "总裁私聊身份已由运行配置固定绑定。");
} else if (config) {
  const pairingPath = path.join(config.paths.runtimeRoot, "pairing.json");
  if (!fs.existsSync(pairingPath)) {
    if (
      config.pairing?.enabled === true &&
      typeof config.pairing?.codeHash === "string" &&
      /^sha256:[0-9a-f]{64}$/.test(config.pairing.codeHash)
    ) {
      const expiresAt = Date.parse(config.pairing?.expiresAt);
      if (!Number.isFinite(expiresAt) || expiresAt <= Date.now()) {
        add(
          "pairing",
          "FAIL",
          "一次性配对码已过期；请重新运行 ./scripts/install --apply 获取新码。",
        );
      } else {
        add("pairing", "WARN", "仍处于一次性配对阶段；只有配对后才能正常接单。");
      }
    } else {
      add("pairing", "FAIL", "既没有总裁绑定，也没有有效配对状态。");
    }
  } else {
    try {
      const stat = fs.lstatSync(pairingPath);
      if (
        !stat.isFile() ||
        stat.isSymbolicLink() ||
        stat.uid !== process.getuid() ||
        safeMode(pairingPath) !== 0o600 ||
        fs.realpathSync(pairingPath) !== pairingPath
      ) {
        throw new Error("pairing_file_identity");
      }
      const state = JSON.parse(fs.readFileSync(pairingPath, "utf8"));
      const keys = Object.keys(state).sort();
      const expectedKeys = [
        "appId",
        "pairedAt",
        "presidentChatId",
        "presidentOpenId",
        "tenantKey",
        "version",
      ];
      if (
        keys.length !== expectedKeys.length ||
        keys.some((key, index) => key !== expectedKeys[index]) ||
        state.version !== 1 ||
        state.appId !== config.appId ||
        !exactPairingIdentifier(state.tenantKey) ||
        (config.tenantKey != null &&
          state.tenantKey !== config.tenantKey) ||
        (config.presidentOpenId !== null &&
          state.presidentOpenId !== config.presidentOpenId) ||
        (config.presidentChatId !== null &&
          state.presidentChatId !== config.presidentChatId) ||
        !exactPairingIdentifier(state.presidentOpenId) ||
        !exactPairingIdentifier(state.presidentChatId) ||
        typeof state.pairedAt !== "string" ||
        !Number.isFinite(Date.parse(state.pairedAt))
      ) {
        throw new Error("pairing_state_invalid");
      }
      add("pairing", "PASS", "权限 0600 的持久配对状态已从可信私聊绑定到当前 App 和 Tenant。");
    } catch {
      add("pairing", "FAIL", "持久配对状态的路径、权限、schema 或身份绑定无效。");
    }
  }
}

const pptRoot = config?.visualFirstPpt?.skillRoot;
if (typeof pptRoot !== "string" || !path.isAbsolute(pptRoot) || !isPlainFile(path.join(pptRoot, "SKILL.md"))) {
  add("visual-first-ppt", "FAIL", "visual-first-ppt Skill 未安装到专用 CODEX_HOME。");
} else {
  try {
    const receiptPath = path.join(pptRoot, ".executive-assistant-install.json");
    if (!isPlainFile(receiptPath)) throw new Error("receipt_missing");
    const receipt = JSON.parse(fs.readFileSync(receiptPath, "utf8"));
    for (const [key, value] of Object.entries(EXPECTED_PPT)) {
      if (receipt[key] !== value) throw new Error(`receipt_mismatch:${key}`);
    }
    const doctorPath = path.join(pptRoot, "scripts", "doctor.mjs");
    if (!isPlainFile(doctorPath) || typeof configuredNode !== "string") {
      throw new Error("ppt_doctor_missing");
    }
    const result = run(configuredNode, [doctorPath, "--json", "--skill-root", pptRoot], {
      timeout: 30_000,
      env: { ...process.env, CODEX_HOME: codexHome },
    });
    const report = JSON.parse(result.stdout);
    const requiredChecks = new Map(
      Array.isArray(report.checks)
        ? report.checks.map((check) => [check.id, check.status])
        : [],
    );
    if (
      ["skill-files", "node", "python"].some(
        (id) => requiredChecks.get(id) !== "PASS",
      )
    ) {
      throw new Error("ppt_local_requirement");
    }
    add(
      "visual-first-ppt",
      "PASS",
      "visual-first-ppt 固定来源、完整文件和本地运行时检查通过；Presentations 与 imagegen 由独立检查判定。",
    );
  } catch {
    add("visual-first-ppt", "FAIL", "visual-first-ppt 来源收据、完整文件或本地运行时不符合锁定版本。");
  }
}

const overall = checks.some((check) => check.status === "FAIL")
  ? "FAIL"
  : checks.some((check) => check.status === "WARN")
    ? "WARN"
    : "PASS";
const report = Object.freeze({
  schemaVersion: 1,
  overall,
  checkedAt: new Date().toISOString(),
  checks,
});

if (json) {
  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
} else {
  process.stdout.write(`总裁助理 doctor：${overall}\n\n`);
  for (const check of checks) {
    const mark = check.status === "PASS" ? "✓" : check.status === "WARN" ? "!" : "✗";
    process.stdout.write(`${mark} ${check.id}：${check.detail}\n`);
  }
}

process.exit(overall === "PASS" ? 0 : overall === "WARN" ? 2 : 1);
NODE
