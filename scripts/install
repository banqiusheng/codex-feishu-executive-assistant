#!/bin/zsh

emulate -LR zsh
set -euo pipefail
setopt pipefail
umask 077

readonly SCRIPT_DIR="${0:A:h}"
readonly REPOSITORY_ROOT="${SCRIPT_DIR:h}"
readonly DEPENDENCY_LOCK="${REPOSITORY_ROOT}/dependencies.lock.json"
readonly CONFIG_TEMPLATE="${REPOSITORY_ROOT}/config/assistant.example.json"
readonly PLIST_TEMPLATE="${REPOSITORY_ROOT}/launchd/com.codex-feishu.executive-assistant.plist.template"
readonly EXECUTIVE_SKILL_SOURCE="${REPOSITORY_ROOT}/skills/executive-assistant"
readonly PPT_LICENSE_NOTICE="${REPOSITORY_ROOT}/LICENSES/visual-first-ppt-MIT.txt"
readonly INSTALL_SUPPORT="${REPOSITORY_ROOT}/scripts/install-support.mjs"
readonly LAUNCHD_LABEL="com.codex-feishu.executive-assistant"
readonly KEYCHAIN_SERVICE="com.codex-feishu-executive-assistant.bot"

typeset mode="auto"
typeset app_id=""
typeset pairing_code=""
typeset pairing_hash=""
typeset pairing_expires_at=""
typeset -a cleanup_paths=()

usage() {
  print -r -- "用法："
  print -r -- "  ./scripts/install --plan"
  print -r -- "  ./scripts/install --verify-only"
  print -r -- "  ./scripts/install --apply [--app-id cli_xxx]"
  print -r -- ""
  print -r -- "说明："
  print -r -- "  --plan         只显示计划，不修改电脑。"
  print -r -- "  --verify-only  只校验仓库锁和交付文件，不修改电脑。"
  print -r -- "  --apply        执行安装；Keychain 和 LaunchAgent 只在此模式变更。"
  print -r -- "  --app-id       可提前给出非秘密 App ID；App Secret 永远不能作为参数。"
}

die() {
  print -u2 -r -- "安装停止：$1"
  exit "${2:-1}"
}

note() {
  print -r -- "• $1"
}

cleanup() {
  local candidate
  for candidate in "${cleanup_paths[@]}"; do
    [[ -n "${candidate}" && -d "${candidate}" && ! -L "${candidate}" ]] || continue
    case "${candidate:t}" in
      ea-ppt-repo.*|ea-visual-first-ppt.*|ea-executive-assistant.*|ea-lark-cli.*)
        /bin/rm -rf "${candidate}"
        ;;
    esac
  done
}
trap cleanup EXIT HUP INT TERM

while (( $# > 0 )); do
  case "$1" in
    --plan)
      [[ "${mode}" == "auto" ]] || die "只能选择一种运行模式。" 64
      mode="plan"
      shift
      ;;
    --verify-only)
      [[ "${mode}" == "auto" ]] || die "只能选择一种运行模式。" 64
      mode="verify"
      shift
      ;;
    --apply)
      [[ "${mode}" == "auto" ]] || die "只能选择一种运行模式。" 64
      mode="apply"
      shift
      ;;
    --app-id)
      (( $# >= 2 )) || die "--app-id 缺少值。" 64
      app_id="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --secret|--app-secret|--token)
      die "秘密不能通过命令行参数传入；请只在 macOS Keychain 安全提示中输入。" 64
      ;;
    *)
      die "未知参数：$1" 64
      ;;
  esac
done

[[ -f "${DEPENDENCY_LOCK}" && ! -L "${DEPENDENCY_LOCK}" ]] ||
  die "dependencies.lock.json 缺失或不是可信普通文件。"
[[ -f "${CONFIG_TEMPLATE}" && ! -L "${CONFIG_TEMPLATE}" ]] ||
  die "配置模板缺失或不是可信普通文件。"
[[ -f "${PLIST_TEMPLATE}" && ! -L "${PLIST_TEMPLATE}" ]] ||
  die "LaunchAgent 模板缺失或不是可信普通文件。"
[[ -f "${EXECUTIVE_SKILL_SOURCE}/SKILL.md" && ! -L "${EXECUTIVE_SKILL_SOURCE}/SKILL.md" ]] ||
  die "executive-assistant Skill 缺失。"
[[ -f "${PPT_LICENSE_NOTICE}" && ! -L "${PPT_LICENSE_NOTICE}" ]] ||
  die "visual-first-ppt 许可证声明缺失或不是可信普通文件。"
[[ -f "${INSTALL_SUPPORT}" && ! -L "${INSTALL_SUPPORT}" ]] ||
  die "安装器兼容性支持脚本缺失或不是可信普通文件。"

typeset node_executable="${commands[node]:-}"
[[ -n "${node_executable}" ]] || die "未找到 Node.js 20 或更高版本。"
node_executable="${node_executable:A}"

verify_repository_contract() {
  local output
  output="$(
    "${node_executable}" --input-type=module - \
      "${DEPENDENCY_LOCK}" "${CONFIG_TEMPLATE}" "${PPT_LICENSE_NOTICE}" <<'NODE'
import { createHash } from "node:crypto";
import fs from "node:fs";

const [lockPath, templatePath, pptLicensePath] = process.argv.slice(2);
const lock = JSON.parse(fs.readFileSync(lockPath, "utf8"));
const expected = {
  bridgeRepository: "https://github.com/VicLuoV5/lark-codex-bridge.git",
  bridgeTag: "v0.1.34",
  bridgeTagObject: "fcc8b1f4cb6ef45ba598cda2f057bb2798e479a1",
  bridgeCommit: "e8b0dc0cdfe2fb378bef7081618138a20d934aa9",
  larkCliVersion: "1.0.72",
  larkCliDarwinArm64Sha256: "b27942b83e8821934ebd34fbb02e0b00bbca949255866b5010795d625442eae2",
  larkCliDarwinAmd64Sha256: "b5dd56d64f9cc1cb7bab80b8eb1dda3c34e76f2a751115a897d0261985b82745",
  pptRepository: "https://github.com/banqiusheng/visual-first-ppt.git",
  pptTag: "v0.3.0",
  pptTagObject: "4962eb9bd5c55e8384b5228993c241b2220fcabb",
  pptCommit: "bb775f68f951c3e444d00623bc88976b20c13e7d",
  pptTree: "5ad18d178e8191105dcc68717e4639d3a68f0c73",
  pptSkillPath: "skills/visual-first-ppt",
  pptSkillTree: "b2fc38bcd1c1d36f18f47543aa63abd1c7e13eba",
  pptLicense: "MIT",
  pptLicenseSha256: "947212107746594a12e5a1b5b3cab1a0c2f5d46b0a1ab5d438c4938adaf5d04e",
  codexMinimum: "0.142.0",
  pnpmVersion: "10.0.0",
};
const actual = {
  bridgeRepository: lock.larkCodexBridge?.repository,
  bridgeTag: lock.larkCodexBridge?.tag,
  bridgeTagObject: lock.larkCodexBridge?.tagObjectSha,
  bridgeCommit: lock.larkCodexBridge?.commitSha,
  larkCliVersion: lock.larkCli?.version,
  larkCliDarwinArm64Sha256: lock.larkCli?.darwinArm64ArchiveSha256,
  larkCliDarwinAmd64Sha256: lock.larkCli?.darwinAmd64ArchiveSha256,
  pptRepository: lock.visualFirstPpt?.repository,
  pptTag: lock.visualFirstPpt?.tag,
  pptTagObject: lock.visualFirstPpt?.tagObjectSha,
  pptCommit: lock.visualFirstPpt?.commitSha,
  pptTree: lock.visualFirstPpt?.treeSha,
  pptSkillPath: lock.visualFirstPpt?.skillPath,
  pptSkillTree: lock.visualFirstPpt?.skillTreeSha,
  pptLicense: lock.visualFirstPpt?.license,
  pptLicenseSha256: lock.visualFirstPpt?.licenseSha256,
  codexMinimum: lock.codex?.minimumVersion,
  pnpmVersion: lock.pnpm?.version,
};
for (const [key, value] of Object.entries(expected)) {
  if (actual[key] !== value) {
    throw new Error(`dependency_lock_mismatch:${key}`);
  }
}
const pptLicense = fs.readFileSync(pptLicensePath);
if (
  createHash("sha256").update(pptLicense).digest("hex") !==
  expected.pptLicenseSha256
) {
  throw new Error("ppt_license_notice_mismatch");
}
const template = JSON.parse(fs.readFileSync(templatePath, "utf8"));
if (
  template.schemaVersion !== 1 ||
  template.secretRef?.type !== "macos-keychain" ||
  template.paths?.larkHome !== "__LARK_HOME__"
) {
  throw new Error("assistant_config_template_invalid");
}
const serialized = JSON.stringify(template);
if (/"(?:appSecret|app_secret|secretValue|accessToken|refreshToken|token)"\s*:/.test(serialized)) {
  throw new Error("assistant_config_template_contains_secret_field");
}
for (const value of [
  expected.larkCliVersion,
  expected.larkCliDarwinArm64Sha256,
  expected.larkCliDarwinAmd64Sha256,
  expected.pptRepository,
  expected.pptTag,
  expected.pptTagObject,
  expected.pptCommit,
  expected.pptTree,
  expected.pptSkillPath,
  expected.pptSkillTree,
]) {
  process.stdout.write(`${value}\n`);
}
NODE
  )" || die "依赖锁或配置模板不符合本仓库固定合同。"

  typeset -ga dependency_contract
  dependency_contract=("${(@f)output}")
  (( ${#dependency_contract[@]} == 10 )) || die "无法读取固定依赖版本。"

  typeset -ga ppt_contract
  ppt_contract=(
    "${dependency_contract[4]}"
    "${dependency_contract[5]}"
    "${dependency_contract[6]}"
    "${dependency_contract[7]}"
    "${dependency_contract[8]}"
    "${dependency_contract[9]}"
    "${dependency_contract[10]}"
  )
}

verify_repository_contract
/usr/bin/plutil -lint "${PLIST_TEMPLATE}" >/dev/null ||
  die "LaunchAgent 模板不是合法 plist。"

print_plan() {
  print -r -- ""
  print -r -- "将执行以下安装："
  note "使用 dependencies.lock.json 的固定版本，不跟随 latest。"
  note "在当前仓库完成冻结依赖安装、构建和 native run client 构建。"
  note "创建 ~/PresidentAssistant 与专用 CODEX_HOME。"
  note "从飞书官方 release 安装并核验私有 lark-cli 1.0.72，不加入 Codex PATH。"
  note "从当前 Codex 可见的官方 primary-runtime marketplace 安装 Presentations。"
  note "安装 executive-assistant 和精确核验的 visual-first-ppt v0.3.0。"
  note "imagegen 只做真实可见性判断；无法用本机证据确认时保持 WARN。"
  note "App Secret 由 /usr/bin/security 自己安全提示，不进入 argv、环境或配置文件。"
  note "初始化独立飞书 CLI 配置，并引导总裁完成日历、通讯录和妙记用户授权。"
  note "生成一个用户级 RunAtLoad + KeepAlive LaunchAgent。"
  note "最后运行只读 doctor；真实飞书连接、配对和能力仍以 doctor/运行时结果为准。"
  print -r -- ""
}

if [[ "${mode}" == "verify" ]]; then
  print -r -- "仓库交付面校验通过：依赖锁、配置模板、Skill 和 LaunchAgent 模板可解析。"
  exit 0
fi

print_plan

if [[ "${mode}" == "plan" ]]; then
  exit 0
fi

if [[ "${mode}" == "auto" ]]; then
  if [[ "${ASSISTANT_TEST_MODE:-0}" == "1" || ! -t 0 || ! -t 1 ]]; then
    print -r -- "当前不是交互终端，仅展示计划；实际安装请在 Mac mini 终端运行 ./scripts/install --apply。"
    exit 0
  fi
  print -n -r -- "输入“安装”继续，其他输入取消："
  IFS= read -r answer
  [[ "${answer}" == "安装" ]] || {
    print -r -- "已取消，电脑未发生变化。"
    exit 0
  }
  mode="apply"
fi

[[ "${mode}" == "apply" ]] || die "内部运行模式无效。"
[[ "${ASSISTANT_TEST_MODE:-0}" != "1" ]] ||
  die "测试模式禁止 --apply；未执行 Keychain、launchctl、构建或目录写入。" 64
[[ -t 0 && -t 1 ]] || die "--apply 必须在交互终端运行。" 64
[[ "$(/usr/bin/uname -s)" == "Darwin" ]] || die "只支持 macOS。"

if [[ -z "${app_id}" ]]; then
  print -n -r -- "请输入飞书 App ID（不是 App Secret）："
  IFS= read -r app_id
fi
[[ "${app_id}" =~ '^cli_[A-Za-z0-9_-]{6,128}$' ]] ||
  die "App ID 格式不正确，应以 cli_ 开头。"

typeset corepack_executable="${commands[corepack]:-}"
typeset codex_executable="${commands[codex]:-}"
[[ -n "${corepack_executable}" ]] || die "未找到 corepack。"
[[ -n "${codex_executable}" ]] || die "未找到 Codex CLI。"
corepack_executable="${corepack_executable:A}"
codex_executable="${codex_executable:A}"
"${node_executable}" "${INSTALL_SUPPORT}" validate-codex-entry \
  "${node_executable}" "${codex_executable}" >/dev/null ||
  die "当前 Codex CLI 不是本版本支持的 Node.js 脚本入口。"

note "安装冻结依赖并构建仓库。"
(
  cd "${REPOSITORY_ROOT}"
  "${corepack_executable}" pnpm install --frozen-lockfile
  "${corepack_executable}" pnpm build
  /bin/zsh packages/action-gateway/native/run-client/build.sh
)

readonly runtime_entry="${REPOSITORY_ROOT}/packages/runtime/dist/cli.js"
readonly gateway_client="${REPOSITORY_ROOT}/dist/public-bin/assistant-gateway"
[[ -f "${runtime_entry}" && ! -L "${runtime_entry}" ]] ||
  die "runtime 构建产物缺失：packages/runtime/dist/cli.js。"
[[ -f "${gateway_client}" && ! -L "${gateway_client}" && -x "${gateway_client}" ]] ||
  die "native gateway run client 构建产物缺失或不可执行。"

readonly assistant_root="${HOME}/PresidentAssistant"
readonly runtime_root="${assistant_root}/runtime"
readonly codex_home="${runtime_root}/codex-home"
readonly skills_root="${codex_home}/skills"
readonly jobs_root="${assistant_root}/jobs"
readonly outputs_root="${assistant_root}/outputs"
readonly ppt_projects_root="${assistant_root}/ppt-projects"
readonly database_path="${runtime_root}/assistant.sqlite"
readonly logs_root="${assistant_root}/logs"
readonly config_dir="${runtime_root}/config"
readonly config_path="${config_dir}/assistant.json"
readonly lark_cli_version="${dependency_contract[1]}"
readonly lark_profile="executive-assistant"
typeset -ar MVP_USER_SCOPES=(
  "calendar:calendar.event:create"
  "calendar:calendar.event:update"
  "contact:user:search"
  "minutes:minutes.search:read"
  "minutes:minutes.basic:read"
  "minutes:minutes.artifacts:read"
)
readonly mvp_user_scope_arg="${(j: :)MVP_USER_SCOPES}"
readonly lark_home="${runtime_root}/lark-home"
readonly lark_cli_install_root="${runtime_root}/lark-cli-${lark_cli_version}"
readonly lark_cli_private_bin="${lark_cli_install_root}/private-bin"
readonly lark_cli_executable="${lark_cli_private_bin}/lark-cli"
readonly lark_cli_receipt="${lark_cli_install_root}/install-receipt.json"
readonly ppt_skill_root="${skills_root}/visual-first-ppt"
readonly executive_skill_root="${skills_root}/executive-assistant"

typeset -a private_directories=(
  "${assistant_root}"
  "${assistant_root}/inbox"
  "${jobs_root}"
  "${outputs_root}"
  "${ppt_projects_root}"
  "${runtime_root}"
  "${codex_home}"
  "${lark_home}"
  "${skills_root}"
  "${config_dir}"
  "${logs_root}"
)

local_directory=""
for local_directory in "${private_directories[@]}"; do
  /bin/mkdir -p "${local_directory}"
  /bin/chmod 0700 "${local_directory}"
done

typeset lark_arch=""
typeset lark_archive_sha=""
case "$(/usr/bin/uname -m)" in
  arm64)
    lark_arch="arm64"
    lark_archive_sha="${dependency_contract[2]}"
    ;;
  x86_64)
    lark_arch="amd64"
    lark_archive_sha="${dependency_contract[3]}"
    ;;
  *)
    die "不支持当前 Mac 架构，无法安装锁定 lark-cli。"
    ;;
esac
readonly lark_archive_name="lark-cli-${lark_cli_version}-darwin-${lark_arch}.tar.gz"
readonly lark_source_url="https://github.com/larksuite/cli/releases/download/v${lark_cli_version}/${lark_archive_name}"

verify_lark_cli_install() {
  [[ -f "${lark_cli_executable}" && ! -L "${lark_cli_executable}" && -x "${lark_cli_executable}" ]] ||
    return 1
  [[ -f "${lark_cli_receipt}" && ! -L "${lark_cli_receipt}" ]] || return 1
  local version_output
  version_output="$("${lark_cli_executable}" --version 2>&1)" || return 1
  [[ "${version_output}" == *"${lark_cli_version}"* ]] || return 1
  "${node_executable}" --input-type=module - \
    "${lark_cli_receipt}" "${lark_cli_executable}" "${lark_cli_version}" \
    "${lark_archive_sha}" "${lark_source_url}" <<'NODE'
import { createHash } from "node:crypto";
import fs from "node:fs";

const [receiptPath, binaryPath, version, archiveSha256, sourceUrl] = process.argv.slice(2);
const receipt = JSON.parse(fs.readFileSync(receiptPath, "utf8"));
const binarySha256 = createHash("sha256").update(fs.readFileSync(binaryPath)).digest("hex");
if (
  receipt.schemaVersion !== 1 ||
  receipt.package !== "@larksuite/cli" ||
  receipt.version !== version ||
  receipt.archiveSha256 !== archiveSha256 ||
  receipt.sourceUrl !== sourceUrl ||
  receipt.binarySha256 !== binarySha256 ||
  typeof receipt.binarySha256 !== "string"
) {
  throw new Error("lark_cli_receipt_mismatch");
}
NODE
}

if [[ -e "${lark_cli_install_root}" ]]; then
  [[ -d "${lark_cli_install_root}" && ! -L "${lark_cli_install_root}" ]] ||
    die "已有 lark-cli 私有安装不是可信目录。"
  verify_lark_cli_install ||
    die "已有 lark-cli 私有安装与固定版本收据不匹配；安装器不会覆盖。"
  note "私有 lark-cli ${lark_cli_version} 已核验，复用现有安装。"
else
  typeset lark_download_root
  lark_download_root="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/ea-lark-cli.XXXXXX")"
  cleanup_paths+=("${lark_download_root}")
  typeset lark_archive_path="${lark_download_root}/${lark_archive_name}"

  note "从飞书官方 release 下载 lark-cli ${lark_cli_version} (${lark_arch})。"
  /usr/bin/curl \
    --fail \
    --location \
    --silent \
    --show-error \
    --proto '=https' \
    --tlsv1.2 \
    --connect-timeout 10 \
    --max-time 180 \
    --max-redirs 3 \
    --output "${lark_archive_path}" \
    "${lark_source_url}"
  [[ "$(/usr/bin/shasum -a 256 "${lark_archive_path}" | /usr/bin/awk '{print $1}')" == "${lark_archive_sha}" ]] ||
    die "lark-cli 官方 archive SHA-256 校验失败。"
  /usr/bin/tar -xzf "${lark_archive_path}" -C "${lark_download_root}"
  [[ -f "${lark_download_root}/lark-cli" && ! -L "${lark_download_root}/lark-cli" ]] ||
    die "lark-cli 官方 archive 中缺少预期可执行文件。"

  typeset lark_staging
  lark_staging="$(/usr/bin/mktemp -d "${runtime_root}/ea-lark-cli.XXXXXX")"
  cleanup_paths+=("${lark_staging}")
  /bin/mkdir -p "${lark_staging}/private-bin"
  /bin/chmod 0700 "${lark_staging}/private-bin"
  /usr/bin/install -m 0500 \
    "${lark_download_root}/lark-cli" \
    "${lark_staging}/private-bin/lark-cli"
  LARK_RECEIPT="${lark_staging}/install-receipt.json" \
  LARK_BINARY="${lark_staging}/private-bin/lark-cli" \
  LARK_VERSION="${lark_cli_version}" \
  LARK_ARCHIVE_SHA="${lark_archive_sha}" \
  LARK_SOURCE_URL="${lark_source_url}" \
    "${node_executable}" --input-type=module <<'NODE'
import { createHash } from "node:crypto";
import fs from "node:fs";

const binarySha256 = createHash("sha256")
  .update(fs.readFileSync(process.env.LARK_BINARY))
  .digest("hex");
const receipt = {
  schemaVersion: 1,
  package: "@larksuite/cli",
  version: process.env.LARK_VERSION,
  archiveSha256: process.env.LARK_ARCHIVE_SHA,
  binarySha256,
  sourceUrl: process.env.LARK_SOURCE_URL,
};
fs.writeFileSync(process.env.LARK_RECEIPT, `${JSON.stringify(receipt, null, 2)}\n`, {
  encoding: "utf8",
  mode: 0o600,
  flag: "wx",
});
NODE
  /bin/chmod 0700 "${lark_staging}"
  /bin/chmod 0700 "${lark_staging}/private-bin"
  /bin/chmod 0500 "${lark_staging}/private-bin/lark-cli"
  /bin/chmod 0600 "${lark_staging}/install-receipt.json"
  /bin/mv "${lark_staging}" "${lark_cli_install_root}"
  verify_lark_cli_install || die "lark-cli 私有安装后的版本或收据校验失败。"
  note "lark-cli ${lark_cli_version} 已安装到私有目录；未加入 Codex PATH。"
fi

install_local_skill() {
  local source="$1"
  local target="$2"
  local name="$3"
  if [[ -e "${target}" ]]; then
    [[ -d "${target}" && ! -L "${target}" ]] || die "${name} 的已有目标不是可信目录。"
    /usr/bin/diff -qr "${source}" "${target}" >/dev/null ||
      die "${name} 已存在但内容与仓库不一致；安装器不会覆盖。"
    note "${name} 已安装且内容一致，复用现有目录。"
    return
  fi
  local staging
  staging="$(/usr/bin/mktemp -d "${skills_root}/ea-${name}.XXXXXX")"
  cleanup_paths+=("${staging}")
  /usr/bin/ditto "${source}" "${staging}"
  /usr/bin/find "${staging}" -type d -exec /bin/chmod 0700 {} \;
  /usr/bin/find "${staging}" -type f -exec /bin/chmod 0600 {} \;
  /bin/mv "${staging}" "${target}"
  note "${name} 已安装到专用 CODEX_HOME。"
}

install_local_skill "${EXECUTIVE_SKILL_SOURCE}" "${executive_skill_root}" "executive-assistant"

verify_ppt_receipt() {
  local root="$1"
  local receipt_mode="$2"
  "${node_executable}" --input-type=module - "${root}" "${receipt_mode}" \
    "${ppt_contract[1]}" "${ppt_contract[2]}" "${ppt_contract[3]}" \
    "${ppt_contract[4]}" "${ppt_contract[5]}" "${ppt_contract[6]}" \
    "${ppt_contract[7]}" <<'NODE'
import fs from "node:fs";
import path from "node:path";

const [
  root,
  receiptMode,
  repository,
  tag,
  tagObjectSha,
  commitSha,
  treeSha,
  skillPath,
  skillTreeSha,
] = process.argv.slice(2);
const receiptPath = path.join(root, ".executive-assistant-install.json");
const receiptStat = fs.lstatSync(receiptPath);
if (
  !receiptStat.isFile() ||
  receiptStat.isSymbolicLink() ||
  receiptStat.uid !== process.getuid() ||
  (receiptStat.mode & 0o777) !== 0o600
) {
  throw new Error("ppt_install_identity_invalid");
}
const receipt = JSON.parse(fs.readFileSync(receiptPath, "utf8"));
const expected =
  receiptMode === "current"
    ? {
        schemaVersion: 2,
        repository,
        tag,
        tagObjectSha,
        commitSha,
        treeSha,
        skillPath,
        skillTreeSha,
      }
    : receiptMode === "legacy"
      ? { schemaVersion: 1, repository, tag, tagObjectSha, commitSha, treeSha }
      : null;
if (expected === null) throw new Error("ppt_install_receipt_mode");
const actualKeys = Object.keys(receipt).sort();
const expectedKeys = Object.keys(expected).sort();
if (
  actualKeys.length !== expectedKeys.length ||
  actualKeys.some((key, index) => key !== expectedKeys[index])
) {
  throw new Error("ppt_install_receipt_shape");
}
for (const [key, value] of Object.entries(expected)) {
  if (receipt[key] !== value) throw new Error(`ppt_install_mismatch:${key}`);
}
NODE
}

verify_existing_ppt_skill() {
  [[ -d "${ppt_skill_root}" && ! -L "${ppt_skill_root}" ]] || return 1
  [[ -f "${ppt_skill_root}/SKILL.md" && ! -L "${ppt_skill_root}/SKILL.md" ]] || return 1
  [[ -f "${ppt_skill_root}/scripts/doctor.mjs" &&
    ! -L "${ppt_skill_root}/scripts/doctor.mjs" ]] || return 1
  [[ -z "$(/usr/bin/find "${ppt_skill_root}" -type l -print -quit)" ]] || return 1
  verify_ppt_receipt "${ppt_skill_root}" "current"
}

verify_legacy_ppt_layout() {
  [[ -d "${ppt_skill_root}" && ! -L "${ppt_skill_root}" ]] || return 1
  [[ ! -e "${ppt_skill_root}/SKILL.md" ]] || return 1
  [[ -f "${ppt_skill_root}/skills/visual-first-ppt/SKILL.md" &&
    ! -L "${ppt_skill_root}/skills/visual-first-ppt/SKILL.md" ]] || return 1
  [[ -f "${ppt_skill_root}/skills/visual-first-ppt/scripts/doctor.mjs" &&
    ! -L "${ppt_skill_root}/skills/visual-first-ppt/scripts/doctor.mjs" ]] || return 1
  [[ -z "$(/usr/bin/find "${ppt_skill_root}/skills/visual-first-ppt" -type l -print -quit)" ]] ||
    return 1
  verify_ppt_receipt "${ppt_skill_root}" "legacy"
}

fetch_ppt_repository() {
  note "下载并精确核验 visual-first-ppt ${ppt_contract[2]}。"
  typeset -g ppt_repository_tmp
  ppt_repository_tmp="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/ea-ppt-repo.XXXXXX")"
  cleanup_paths+=("${ppt_repository_tmp}")
  /usr/bin/git -C "${ppt_repository_tmp}" init -q
  /usr/bin/git -C "${ppt_repository_tmp}" remote add origin "${ppt_contract[1]}"
  /usr/bin/git -C "${ppt_repository_tmp}" \
    -c protocol.version=2 fetch --quiet --depth=1 origin \
    "refs/tags/${ppt_contract[2]}:refs/tags/${ppt_contract[2]}"

  [[ "$(/usr/bin/git -C "${ppt_repository_tmp}" rev-parse "refs/tags/${ppt_contract[2]}")" == "${ppt_contract[3]}" ]] ||
    die "visual-first-ppt tag object 校验失败。"
  [[ "$(/usr/bin/git -C "${ppt_repository_tmp}" rev-parse "refs/tags/${ppt_contract[2]}^{}")" == "${ppt_contract[4]}" ]] ||
    die "visual-first-ppt commit 校验失败。"
  [[ "$(/usr/bin/git -C "${ppt_repository_tmp}" rev-parse "refs/tags/${ppt_contract[2]}^{tree}")" == "${ppt_contract[5]}" ]] ||
    die "visual-first-ppt tree 校验失败。"
  [[ "$(/usr/bin/git -C "${ppt_repository_tmp}" rev-parse "${ppt_contract[2]}:${ppt_contract[6]}")" == "${ppt_contract[7]}" ]] ||
    die "visual-first-ppt Skill 子树校验失败。"
}

stage_ppt_skill() {
  typeset -g ppt_staging
  ppt_staging="$(/usr/bin/mktemp -d "${skills_root}/ea-visual-first-ppt.XXXXXX")"
  cleanup_paths+=("${ppt_staging}")
  /usr/bin/git -C "${ppt_repository_tmp}" \
    archive "${ppt_contract[2]}" -- "${ppt_contract[6]}" |
    /usr/bin/tar -x -C "${ppt_staging}" --strip-components 2
  [[ -f "${ppt_staging}/SKILL.md" && ! -L "${ppt_staging}/SKILL.md" ]] ||
    die "visual-first-ppt archive 中缺少 Skill 入口。"
  [[ -f "${ppt_staging}/scripts/doctor.mjs" &&
    ! -L "${ppt_staging}/scripts/doctor.mjs" ]] ||
    die "visual-first-ppt archive 中缺少 doctor。"
  [[ -z "$(/usr/bin/find "${ppt_staging}" -type l -print -quit)" ]] ||
    die "visual-first-ppt Skill 子树包含不允许的符号链接。"
}

write_ppt_receipt() {
  RECEIPT_PATH="${ppt_staging}/.executive-assistant-install.json" \
  PPT_REPOSITORY="${ppt_contract[1]}" \
  PPT_TAG="${ppt_contract[2]}" \
  PPT_TAG_OBJECT="${ppt_contract[3]}" \
  PPT_COMMIT="${ppt_contract[4]}" \
  PPT_TREE="${ppt_contract[5]}" \
  PPT_SKILL_PATH="${ppt_contract[6]}" \
  PPT_SKILL_TREE="${ppt_contract[7]}" \
    "${node_executable}" --input-type=module <<'NODE'
import fs from "node:fs";

const receipt = {
  schemaVersion: 2,
  repository: process.env.PPT_REPOSITORY,
  tag: process.env.PPT_TAG,
  tagObjectSha: process.env.PPT_TAG_OBJECT,
  commitSha: process.env.PPT_COMMIT,
  treeSha: process.env.PPT_TREE,
  skillPath: process.env.PPT_SKILL_PATH,
  skillTreeSha: process.env.PPT_SKILL_TREE,
};
fs.writeFileSync(process.env.RECEIPT_PATH, `${JSON.stringify(receipt, null, 2)}\n`, {
  encoding: "utf8",
  mode: 0o600,
  flag: "wx",
});
NODE
  /usr/bin/find "${ppt_staging}" -type d -exec /bin/chmod 0700 {} \;
  /usr/bin/find "${ppt_staging}" -type f -exec /bin/chmod 0600 {} \;
}

if [[ -e "${ppt_skill_root}" ]] && verify_existing_ppt_skill; then
  note "visual-first-ppt 固定版本已存在，复用现有目录。"
elif [[ ! -e "${ppt_skill_root}" ]]; then
  fetch_ppt_repository
  stage_ppt_skill
  write_ppt_receipt
  /bin/mv "${ppt_staging}" "${ppt_skill_root}"
  verify_existing_ppt_skill ||
    die "visual-first-ppt 安装后的 Skill 子树或来源收据校验失败。"
  note "visual-first-ppt 已安装并记录固定来源。"
elif verify_legacy_ppt_layout; then
  fetch_ppt_repository
  stage_ppt_skill
  /usr/bin/diff -qr \
    "${ppt_skill_root}/skills/visual-first-ppt" \
    "${ppt_staging}" >/dev/null ||
    die "visual-first-ppt 旧布局中的 Skill 内容已变化；安装器不会覆盖。"
  write_ppt_receipt

  readonly ppt_quarantine_root="${runtime_root}/quarantine"
  if [[ -e "${ppt_quarantine_root}" ]]; then
    [[ -d "${ppt_quarantine_root}" && ! -L "${ppt_quarantine_root}" ]] ||
      die "visual-first-ppt 旧布局隔离目录不是可信目录。"
  else
    /bin/mkdir "${ppt_quarantine_root}"
  fi
  /bin/chmod 0700 "${ppt_quarantine_root}"
  typeset ppt_quarantine
  ppt_quarantine="$(/usr/bin/mktemp -d "${ppt_quarantine_root}/visual-first-ppt-legacy.XXXXXX")"
  /bin/chmod 0700 "${ppt_quarantine}"
  /bin/mv "${ppt_skill_root}" "${ppt_quarantine}/visual-first-ppt-repository"
  if ! /bin/mv "${ppt_staging}" "${ppt_skill_root}"; then
    /bin/mv "${ppt_quarantine}/visual-first-ppt-repository" "${ppt_skill_root}" ||
      die "visual-first-ppt 迁移失败且旧布局无法自动恢复。"
    die "visual-first-ppt 迁移失败；已恢复旧布局。"
  fi
  if ! verify_existing_ppt_skill; then
    /bin/mv \
      "${ppt_skill_root}" \
      "${ppt_quarantine}/visual-first-ppt-failed-migration" ||
      die "visual-first-ppt 新布局校验失败，且无法隔离失败的新布局。"
    /bin/mv "${ppt_quarantine}/visual-first-ppt-repository" "${ppt_skill_root}" ||
      die "visual-first-ppt 新布局校验失败，且旧布局无法自动恢复。"
    die "visual-first-ppt 新布局校验失败；已恢复旧布局。"
  fi
  note "已把安装器早期生成的 visual-first-ppt 整仓布局移入可恢复隔离目录；不会直接删除。"
else
  die "visual-first-ppt 已存在但不是当前固定 Skill 或可验证旧布局；安装器不会覆盖。"
fi

note "从当前 Codex 的官方 marketplace 清单定位 Presentations。"
typeset current_marketplace_json
current_marketplace_json="$(
  "${codex_executable}" plugin marketplace list --json 2>/dev/null
)" || die "BLOCKED_CAPABILITY：当前 Codex 无法列出官方 marketplace。"

typeset -a presentations_contract
presentations_contract=("${(@f)$(
  print -rn -- "${current_marketplace_json}" |
    "${node_executable}" "${INSTALL_SUPPORT}" presentations-contract |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      if (
        typeof result.root !== "string" ||
        typeof result.version !== "string"
      ) {
        process.exit(2);
      }
      process.stdout.write(`${result.root}\n${result.version}\n`);
    '
)}") || die "BLOCKED_CAPABILITY：当前 Codex 看不到官方 presentations@openai-primary-runtime。"
(( ${#presentations_contract[@]} == 2 )) ||
  die "BLOCKED_CAPABILITY：官方 Presentations marketplace 身份无法确定。"

readonly presentations_marketplace_root="${presentations_contract[1]}"
readonly presentations_plugin_version="${presentations_contract[2]}"
[[ -d "${presentations_marketplace_root}" && ! -L "${presentations_marketplace_root}" ]] ||
  die "BLOCKED_CAPABILITY：Codex 返回的 primary-runtime marketplace 根不可用。"
[[ -f "${presentations_marketplace_root}/.agents/plugins/marketplace.json" &&
  ! -L "${presentations_marketplace_root}/.agents/plugins/marketplace.json" ]] ||
  die "BLOCKED_CAPABILITY：Codex 返回的 primary-runtime marketplace 缺少可信清单。"

CODEX_HOME="${codex_home}" "${codex_executable}" plugin marketplace add \
  "${presentations_marketplace_root}" >/dev/null ||
  die "BLOCKED_CAPABILITY：无法把官方 primary-runtime marketplace 注册到专用 CODEX_HOME。"

readonly presentations_quarantine_root="${runtime_root}/quarantine"
typeset presentations_install_result_json
presentations_install_result_json="$(
  "${node_executable}" "${INSTALL_SUPPORT}" ensure-presentations \
    "${codex_executable}" \
    "${codex_home}" \
    "${presentations_marketplace_root}" \
    "${presentations_plugin_version}" \
    "${presentations_quarantine_root}"
)" ||
  die "BLOCKED_CAPABILITY：专用 CODEX_HOME 中的 Presentations 来源或版本不匹配；安装器不会覆盖。"
typeset -a presentations_install_result
presentations_install_result=("${(@f)$(
  print -rn -- "${presentations_install_result_json}" |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      process.stdout.write(`${result.action}\n${result.backupPath ?? ""}\n`);
    '
)}") || die "BLOCKED_CAPABILITY：Presentations 安装结果无法验证。"
if [[ "${presentations_install_result[1]:-}" == "upgraded" ]]; then
  note "已把旧版官方 Presentations 保存到 0700 可恢复隔离目录后完成升级。"
fi
note "Presentations ${presentations_plugin_version} 已由 Codex 官方 marketplace 安装并启用。"

if [[ -f "${codex_home}/skills/.system/imagegen/SKILL.md" &&
  ! -L "${codex_home}/skills/.system/imagegen/SKILL.md" ]]; then
  note "WARN：专用 CODEX_HOME 存在 imagegen Skill，但系统 image_gen 工具仍需目标机新任务确认。"
else
  note "WARN：只读本地证据无法确认专用 CODEX_HOME 暴露 imagegen；真实 PPT 保持 BLOCKED_CAPABILITY，待目标机验收。"
fi

note "检查专用 Codex 登录。"
if ! CODEX_HOME="${codex_home}" "${codex_executable}" login status >/dev/null 2>&1; then
  print -r -- "接下来打开 Codex 官方登录流程，只写入专用 CODEX_HOME。"
  CODEX_HOME="${codex_home}" "${codex_executable}" login
fi
CODEX_HOME="${codex_home}" "${codex_executable}" login status >/dev/null 2>&1 ||
  die "专用 Codex 登录未完成。"

if /usr/bin/security find-generic-password -a "${app_id}" -s "${KEYCHAIN_SERVICE}" >/dev/null 2>&1; then
  note "Bot App Secret 的 Keychain item 已存在；安装器不会显示或覆盖。"
else
  print -r -- ""
  print -r -- "macOS 即将安全提示输入 App Secret。输入内容不会进入脚本 argv、环境或配置文件。"
  /usr/bin/security add-generic-password \
    -a "${app_id}" \
    -s "${KEYCHAIN_SERVICE}" \
    -w
  /usr/bin/security find-generic-password -a "${app_id}" -s "${KEYCHAIN_SERVICE}" >/dev/null 2>&1 ||
    die "Keychain item 未能保存。"
fi

note "初始化机器人专用的飞书 CLI 配置。"
/usr/bin/security find-generic-password \
  -w \
  -a "${app_id}" \
  -s "${KEYCHAIN_SERVICE}" |
  HOME="${lark_home}" "${lark_cli_executable}" \
    --profile "${lark_profile}" \
    config init \
    --app-id "${app_id}" \
    --app-secret-stdin \
    --brand feishu \
    --name "${lark_profile}" >/dev/null ||
  die "飞书 CLI 配置初始化失败；App Secret 未写入本仓库配置。"
HOME="${lark_home}" "${lark_cli_executable}" \
  --profile "${lark_profile}" \
  config strict-mode off >/dev/null ||
  die "飞书 CLI 无法启用 Bot 与 User 双身份能力。"

lark_app_missing_scopes() {
  local app_scope_json
  app_scope_json="$(
    HOME="${lark_home}" "${lark_cli_executable}" \
      --profile "${lark_profile}" \
      auth scopes --json 2>/dev/null
  )" || return 1
  print -rn -- "${app_scope_json}" |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      const required = process.argv.slice(1);
      if (!Array.isArray(result?.userScopes)) process.exit(2);
      const enabled = new Set(result.userScopes);
      process.stdout.write(required.filter((scope) => !enabled.has(scope)).join("\n"));
    ' "${MVP_USER_SCOPES[@]}"
}

typeset missing_app_scope_output
missing_app_scope_output="$(lark_app_missing_scopes)" ||
  die "无法读取飞书应用已生效的用户权限。"
typeset -a missing_app_scopes=()
if [[ -n "${missing_app_scope_output}" ]]; then
  missing_app_scopes=(${(f)missing_app_scope_output})
fi
if (( ${#missing_app_scopes[@]} > 0 )); then
  die "BLOCKED_SCOPE：飞书应用尚未生效以下 MVP 权限：${(j:, :)missing_app_scopes}。请发布并批准应用版本后重跑安装。"
fi
note "飞书应用层 6 项 MVP 用户权限已生效。"

lark_user_auth_is_healthy() {
  local auth_json
  auth_json="$(
    HOME="${lark_home}" "${lark_cli_executable}" \
      --profile "${lark_profile}" \
      auth status --json --verify 2>/dev/null
  )" || return 1
  print -rn -- "${auth_json}" |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      if (
        result?.identity !== "user" ||
        result?.verified !== true ||
        result?.identities?.user?.available !== true ||
        result?.identities?.user?.verified !== true ||
        result?.identities?.user?.status !== "ready" ||
        result?.identities?.user?.tokenStatus !== "valid"
      ) {
        process.exit(2);
      }
    ' >/dev/null
}

lark_user_scope_check_json() {
  local check_json
  local check_status=0
  check_json="$(
    HOME="${lark_home}" "${lark_cli_executable}" \
      --profile "${lark_profile}" \
      auth check --scope "${mvp_user_scope_arg}" --json 2>/dev/null
  )" || check_status=$?
  (( check_status == 0 || check_status == 1 )) || return 1
  print -rn -- "${check_json}"
}

lark_user_scopes_are_healthy() {
  local check_json
  check_json="$(lark_user_scope_check_json)" || return 1
  print -rn -- "${check_json}" |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      const missing = result?.missing == null ? [] : result.missing;
      if (
        result?.ok !== true ||
        !Array.isArray(missing) ||
        missing.length !== 0
      ) {
        process.exit(2);
      }
    ' >/dev/null
}

lark_user_missing_scopes() {
  local check_json
  check_json="$(lark_user_scope_check_json)" || return 1
  print -rn -- "${check_json}" |
    "${node_executable}" --input-type=module -e '
      let raw = "";
      for await (const chunk of process.stdin) raw += chunk;
      const result = JSON.parse(raw);
      const required = new Set(process.argv.slice(1));
      const missing = result?.missing == null ? [] : result.missing;
      if (
        !Array.isArray(missing) ||
        missing.some(
          (scope) => typeof scope !== "string" || !required.has(scope),
        )
      ) {
        process.exit(2);
      }
      process.stdout.write(missing.join("\n"));
    ' "${MVP_USER_SCOPES[@]}"
}

typeset user_identity_healthy="no"
if lark_user_auth_is_healthy; then
  user_identity_healthy="yes"
fi

if [[ "${user_identity_healthy}" == "yes" ]] && lark_user_scopes_are_healthy; then
  note "飞书用户授权仍然有效，复用现有授权。"
else
  typeset -a missing_user_scopes=()
  typeset requested_user_scope_arg="${mvp_user_scope_arg}"
  if [[ "${user_identity_healthy}" == "yes" ]]; then
    typeset missing_user_scope_output
    missing_user_scope_output="$(lark_user_missing_scopes)" ||
      die "无法读取飞书用户授权的精确权限差额。"
    if [[ -n "${missing_user_scope_output}" ]]; then
      missing_user_scopes=(${(f)missing_user_scope_output})
    fi
    (( ${#missing_user_scopes[@]} > 0 )) ||
      die "飞书用户授权状态异常，但没有可安全申请的缺失 MVP 权限。"
    requested_user_scope_arg="${(j: :)missing_user_scopes}"
  fi
  print -r -- ""
  print -r -- "接下来会打开飞书授权页，仅请求当前缺失的 MVP 权限：${requested_user_scope_arg}"
  HOME="${lark_home}" "${lark_cli_executable}" \
    --profile "${lark_profile}" \
    auth login --scope "${requested_user_scope_arg}" ||
    die "飞书用户授权未完成。"
fi
lark_user_auth_is_healthy && lark_user_scopes_are_healthy ||
  die "飞书用户授权健康检查或 6 项 MVP 权限检查未通过。"

generate_pairing_contract() {
  typeset -a generated
  generated=("${(@f)$(
    "${node_executable}" --input-type=module <<'NODE'
import { createHash, randomBytes } from "node:crypto";
const code = randomBytes(8).toString("hex").toUpperCase();
const hash = `sha256:${createHash("sha256").update(code, "utf8").digest("hex")}`;
const expiresAt = new Date(Date.now() + 30 * 60 * 1000).toISOString();
process.stdout.write(`${code}\n${hash}\n${expiresAt}\n`);
NODE
  )}")
  (( ${#generated[@]} == 3 )) || die "无法生成一次性配对码。"
  pairing_code="${generated[1]}"
  pairing_hash="${generated[2]}"
  pairing_expires_at="${generated[3]}"
}

if [[ -e "${config_path}" ]]; then
  [[ -f "${config_path}" && ! -L "${config_path}" ]] ||
    die "已有运行配置不是可信普通文件。"
  /bin/chmod 0600 "${config_path}"
  typeset existing_config_state
  existing_config_state="$("${node_executable}" --input-type=module - \
    "${config_path}" "${app_id}" "${runtime_root}" "${lark_home}" \
    "${lark_cli_executable}" \
    "${presentations_plugin_version}" <<'NODE'
import fs from "node:fs";
import path from "node:path";
const [
  configPath,
  expectedAppId,
  expectedRuntimeRoot,
  expectedLarkHome,
  expectedLarkCli,
  expectedPresentationsVersion,
] = process.argv.slice(2);
const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
if (
  config.schemaVersion !== 1 ||
  config.appId !== expectedAppId ||
  (config.tenantKey != null &&
    (typeof config.tenantKey !== "string" ||
      !/^[A-Za-z0-9_-]{2,128}$/.test(config.tenantKey))) ||
  config.paths?.runtimeRoot !== expectedRuntimeRoot ||
  config.paths?.larkHome !== expectedLarkHome ||
  config.executables?.larkCli !== expectedLarkCli ||
  config.visualFirstPpt?.presentationsPlugin?.id !==
    "presentations@openai-primary-runtime" ||
  config.visualFirstPpt?.presentationsPlugin?.version !==
    expectedPresentationsVersion
) {
  throw new Error("existing_config_identity_mismatch");
}
const serialized = JSON.stringify(config);
if (/"(?:appSecret|app_secret|secretValue|accessToken|refreshToken|token)"\s*:/.test(serialized)) {
  throw new Error("existing_config_contains_secret_field");
}
const pairingPath = path.join(expectedRuntimeRoot, "pairing.json");
const canRenewPairing =
  config.presidentOpenId === null &&
  config.presidentChatId === null &&
  config.pairing?.enabled === true &&
  !fs.existsSync(pairingPath);
process.stdout.write(canRenewPairing ? "renew-pairing" : "preserve");
NODE
  )" || die "已有运行配置与本次安装身份不一致。"
  typeset executable_refresh_result
  executable_refresh_result="$(
    "${node_executable}" "${INSTALL_SUPPORT}" refresh-runtime-executables \
      "${config_path}" "${app_id}" "${runtime_root}" "${lark_home}" \
      "${lark_cli_executable}" "${presentations_plugin_version}" \
      "${node_executable}" "${codex_executable}"
  )" || die "无法安全刷新运行配置中的 Node/Codex 启动路径。"
  if [[ "${executable_refresh_result}" == '{"action":"updated"}' ]]; then
    note "已原子刷新运行配置中的 Node/Codex 启动路径。"
  elif [[ "${executable_refresh_result}" != '{"action":"unchanged"}' ]]; then
    die "运行配置启动路径刷新结果无法验证。"
  fi
  if [[ "${existing_config_state}" == "renew-pairing" ]]; then
    generate_pairing_contract
    PAIRING_HASH="${pairing_hash}" \
    PAIRING_EXPIRES_AT="${pairing_expires_at}" \
      "${node_executable}" --input-type=module - "${config_path}" <<'NODE'
import fs from "node:fs";
import path from "node:path";

const [target] = process.argv.slice(2);
const config = JSON.parse(fs.readFileSync(target, "utf8"));
if (
  config.presidentOpenId !== null ||
  config.presidentChatId !== null ||
  config.pairing?.enabled !== true
) {
  throw new Error("pairing_state_no_longer_renewable");
}
config.pairing = {
  ...config.pairing,
  enabled: true,
  codeHash: process.env.PAIRING_HASH,
  expiresAt: process.env.PAIRING_EXPIRES_AT,
};
const serialized = `${JSON.stringify(config, null, 2)}\n`;
const temp = path.join(path.dirname(target), `.assistant.json.${process.pid}.tmp`);
const fd = fs.openSync(temp, "wx", 0o600);
try {
  fs.writeFileSync(fd, serialized, "utf8");
  fs.fsyncSync(fd);
} finally {
  fs.closeSync(fd);
}
try {
  fs.renameSync(temp, target);
} catch (error) {
  fs.rmSync(temp, { force: true });
  throw error;
}
NODE
    /bin/chmod 0600 "${config_path}"
    note "尚未完成总裁配对，已安全刷新一次性配对码。"
  else
    [[ "${existing_config_state}" == "preserve" ]] ||
      die "已有运行配置状态无法识别。"
    note "已有同 App ID 配置保持不变，不重置已完成的配对状态。"
  fi
else
  generate_pairing_contract

  CONFIG_TEMPLATE_PATH="${CONFIG_TEMPLATE}" \
  CONFIG_PATH="${config_path}" \
  APP_ID="${app_id}" \
  PAIRING_HASH="${pairing_hash}" \
  PAIRING_EXPIRES_AT="${pairing_expires_at}" \
  ASSISTANT_ROOT="${assistant_root}" \
  RUNTIME_ROOT="${runtime_root}" \
  JOBS_ROOT="${jobs_root}" \
  OUTPUTS_ROOT="${outputs_root}" \
  PPT_PROJECTS_ROOT="${ppt_projects_root}" \
  CODEX_HOME_PATH="${codex_home}" \
  LARK_HOME_PATH="${lark_home}" \
  DATABASE_PATH="${database_path}" \
  LOGS_ROOT="${logs_root}" \
  NODE_EXECUTABLE="${node_executable}" \
  CODEX_EXECUTABLE="${codex_executable}" \
  LARK_CLI_EXECUTABLE="${lark_cli_executable}" \
  GATEWAY_CLIENT="${gateway_client}" \
  RUNTIME_ENTRY="${runtime_entry}" \
  PPT_SKILL_ROOT="${ppt_skill_root}" \
  PRESENTATIONS_PLUGIN_VERSION="${presentations_plugin_version}" \
    "${node_executable}" --input-type=module <<'NODE'
import fs from "node:fs";
import path from "node:path";

const template = JSON.parse(fs.readFileSync(process.env.CONFIG_TEMPLATE_PATH, "utf8"));
const replacements = new Map([
  ["__APP_ID__", process.env.APP_ID],
  ["__PAIRING_CODE_HASH__", process.env.PAIRING_HASH],
  ["__PAIRING_EXPIRES_AT__", process.env.PAIRING_EXPIRES_AT],
  ["__ASSISTANT_ROOT__", process.env.ASSISTANT_ROOT],
  ["__RUNTIME_ROOT__", process.env.RUNTIME_ROOT],
  ["__JOBS_ROOT__", process.env.JOBS_ROOT],
  ["__OUTPUTS_ROOT__", process.env.OUTPUTS_ROOT],
  ["__PPT_PROJECTS_ROOT__", process.env.PPT_PROJECTS_ROOT],
  ["__CODEX_HOME__", process.env.CODEX_HOME_PATH],
  ["__LARK_HOME__", process.env.LARK_HOME_PATH],
  ["__DATABASE_PATH__", process.env.DATABASE_PATH],
  ["__LOGS_ROOT__", process.env.LOGS_ROOT],
  ["__NODE_EXECUTABLE__", process.env.NODE_EXECUTABLE],
  ["__CODEX_EXECUTABLE__", process.env.CODEX_EXECUTABLE],
  ["__LARK_CLI_EXECUTABLE__", process.env.LARK_CLI_EXECUTABLE],
  ["__GATEWAY_CLIENT__", process.env.GATEWAY_CLIENT],
  ["__RUNTIME_ENTRY__", process.env.RUNTIME_ENTRY],
  ["__VISUAL_FIRST_PPT_ROOT__", process.env.PPT_SKILL_ROOT],
  ["__PRESENTATIONS_PLUGIN_VERSION__", process.env.PRESENTATIONS_PLUGIN_VERSION],
]);
function replace(value) {
  if (typeof value === "string") return replacements.get(value) ?? value;
  if (Array.isArray(value)) return value.map(replace);
  if (value && typeof value === "object") {
    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, replace(item)]));
  }
  return value;
}
const config = replace(template);
const serialized = `${JSON.stringify(config, null, 2)}\n`;
if (serialized.includes("__")) throw new Error("unresolved_config_placeholder");
if (/"(?:appSecret|app_secret|secretValue|accessToken|refreshToken|token)"\s*:/.test(serialized)) {
  throw new Error("generated_config_contains_secret_field");
}
const target = process.env.CONFIG_PATH;
const temp = path.join(path.dirname(target), `.assistant.json.${process.pid}.tmp`);
const fd = fs.openSync(temp, "wx", 0o600);
try {
  fs.writeFileSync(fd, serialized, "utf8");
  fs.fsyncSync(fd);
} finally {
  fs.closeSync(fd);
}
fs.renameSync(temp, target);
NODE
  /bin/chmod 0600 "${config_path}"
  note "已生成不含秘密的运行配置。"
fi

readonly launch_agents_dir="${HOME}/Library/LaunchAgents"
readonly plist_path="${launch_agents_dir}/${LAUNCHD_LABEL}.plist"
/bin/mkdir -p "${launch_agents_dir}"

typeset minimal_path="${node_executable:h}:${codex_executable:h}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
"${node_executable}" "${INSTALL_SUPPORT}" render-launchd \
  "${PLIST_TEMPLATE}" \
  "${plist_path}" \
  "${node_executable}" \
  "${runtime_entry}" \
  "${config_path}" \
  "${REPOSITORY_ROOT}" \
  "${codex_home}" \
  "${HOME}" \
  "${minimal_path}" \
  "${logs_root}/assistant.stdout.log" \
  "${logs_root}/assistant.stderr.log" ||
  die "LaunchAgent 配置渲染失败。"
/bin/chmod 0644 "${plist_path}"
/usr/bin/plutil -lint "${plist_path}" >/dev/null || die "渲染后的 LaunchAgent plist 无效。"

readonly launch_domain="gui/$(/usr/bin/id -u)"
typeset launchd_reload_result
launchd_reload_result="$(
  "${node_executable}" "${INSTALL_SUPPORT}" reload-launchd \
    "/bin/launchctl" \
    "${launch_domain}" \
    "${LAUNCHD_LABEL}" \
    "${plist_path}"
)" || die "LaunchAgent 卸载或重新注册失败；请运行只读 doctor 获取状态。"
note "单一 LaunchAgent 已注册并请求启动。"

print -r -- ""
if [[ -n "${pairing_code}" ]]; then
  print -r -- "一次性飞书配对码：${pairing_code}"
  print -r -- "请在 ${pairing_expires_at} 前由总裁本人私聊机器人发送。不要发到群聊。"
fi
print -r -- "安装文件和 LaunchAgent 已写入；下面运行只读 doctor。imagegen 在目标机真实 PPT 验收前会保持 WARN。"
"${SCRIPT_DIR}/doctor" --config "${config_path}" || true
print -r -- ""
print -r -- "以后可运行：./scripts/doctor"
