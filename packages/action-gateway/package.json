{
  "name": "@executive-assistant/action-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @executive-assistant/job-store build",
    "build": "tsup src/index.ts --format esm --dts",
    "pretypecheck": "pnpm --filter @executive-assistant/job-store build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @executive-assistant/job-store build",
    "test": "vitest run"
  },
  "dependencies": {
    "@executive-assistant/contracts": "workspace:*",
    "@executive-assistant/job-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
