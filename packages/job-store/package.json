{
  "name": "@executive-assistant/job-store",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @executive-assistant/contracts build",
    "build": "tsup src/index.ts --format esm --dts",
    "pretypecheck": "pnpm --filter @executive-assistant/contracts build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @executive-assistant/contracts build",
    "test": "vitest run"
  },
  "dependencies": {
    "@executive-assistant/contracts": "workspace:*",
    "better-sqlite3": "12.11.1",
    "json-canonicalize": "2.0.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.0",
    "@types/proper-lockfile": "4.1.4",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
